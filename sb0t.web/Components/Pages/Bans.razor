@page "/bans"
@attribute [Authorize]
@inject ServerService Server
@inject LocalizationService L
@implements IDisposable

<div class="card">
    <h1>@L.T("BannedUsers")</h1>
    <p class="sub">@L.T("BannedUsersSub")</p>
    <div class="row" style="margin-bottom:10px;">
        <button class="btn secondary" @onclick="Refresh" style="padding:6px 14px;font-size:12px;">@L.T("Refresh")</button>
    </div>
    <table>
        <thead><tr><th>@L.T("Name")</th><th>@L.T("Version")</th><th>@L.T("Guid")</th><th>@L.T("IP")</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in _bans)
            {
                <tr>
                    <td><b>@b.Name</b></td>
                    <td>@b.Version</td>
                    <td>@b.Guid</td>
                    <td>@b.Ip</td>
                    <td style="width:90px;"><button class="btn danger" style="padding:5px 12px;font-size:12px;" @onclick="() => Unban(b.Name)">@L.T("Unban")</button></td>
                </tr>
            }
        </tbody>
    </table>
    @if (!_bans.Any())
    {
        <p class="sub">@L.T("NoBans")</p>
    }
</div>

@code {
    private List<BanRow> _bans = new();
    private Timer? _timer;

    protected override void OnInitialized()
    {
        Refresh();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _timer = new Timer(_ => SafeTick(), null, 3000, 3000);
    }

    private void SafeTick()
    {
        try
        {
            InvokeAsync(Refresh);
        }
        catch (ObjectDisposedException) { }
        catch { }
    }

    private void Refresh()
    {
        try
        {
            _bans = Server.Bans.ToList();
            StateHasChanged();
        }
        catch { }
    }

    private void Unban(string name)
    {
        Server.Unban(name);
        Refresh();
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
